# NODE_ENV: Runtime environment (development | staging | production)
NODE_ENV="production"

# PORT: Server port (3000 hardcoded in container infrastructure)
PORT=3000

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: Base URL where this platform is hosted
APP_URL="https://ednexus.edu"

# DATABASE_URL: Database connection string (SQLite dev / PostgreSQL prod)
DATABASE_URL="file:./dev.db"

# JWT_SECRET: Secret key for signing JSON Web Tokens
JWT_SECRET="edtech_production_jwt_secret_key_2026_change_in_prod"

# SIGNED_URL_SECRET: Secret key for HMAC signing video stream CDN tokens
SIGNED_URL_SECRET="ednexus-private-cdn-secret-key-998877665544332211"

# LOG_LEVEL: Application logging level (INFO | WARN | ERROR | SECURITY | AUDIT)
LOG_LEVEL="INFO"

# LOG_FORMAT: Console formatting style (json | text)
LOG_FORMAT="json"
